{
  "$schema": "node_modules/wrangler/config-schema.toml",
  "name": "civicsignal",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // The account is named rather than inferred, because the token on this machine
  // can see two of them and wrangler refuses to guess in a non-interactive run.
  "account_id": "ad5ec479b9a421faa2ed06c3d1c2b23a",
  "vars": {
    "PRODUCT_NAME": "CivicSignal",
    "FREE_MONTHLY_ALLOWANCE": "1000",
    "CORPUS_TEXT_MODE": "d1",
    "PUBLIC_API_BASE_URL": "https://api.civicsignal.chesterhillsolutions.ca"
  },
  "kv_namespaces": [
    { "binding": "CIVIC_CACHE", "id": "45d4754592494e87aa7e2a62e42abbaa" },
    { "binding": "API_KEYS", "id": "2d0152b0958c48fab4a98b3046e0c08e" }
  ],
  "d1_databases": [
    {
      "binding": "CIVIC_DB",
      "database_name": "civicsignal",
      "database_id": "8056b1a0-f858-4f89-a332-91f7f350eb7b",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "CORPORA", "bucket_name": "civicsignal-corpus" }],
  "durable_objects": {
    "bindings": [{ "name": "API_KEY_USAGE", "class_name": "ApiKeyUsageDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ApiKeyUsageDO"] }],
  // The encoder is a Worker in this account, called through a service binding
  // rather than by its address.
  //
  // A Worker cannot fetch a `workers.dev` address on this account — it answers
  // `1042` — and the custom domain is for customers, not for the product's own
  // plumbing. A service binding is the direct call, with no DNS and no
  // workers.dev.
  "services": [{ "binding": "ENCODER_SERVICE", "service": "civicsignal-encoder" }],
  "vectorize": [
    {
      "binding": "VECTORIZE",
      // EmbeddingGemma 2 is 768 dimensions. The bge-m3 index is 1024, so the
      // two cannot share a binding: a vector of one length is not a vector of
      // the other, and an index's dimension is fixed when it is created.
      "index_name": "civicsignal-statutes-gemma"
    }
  ],
  "ai": { "binding": "AI" },
  // The workers.dev address as well, so there is a working URL whatever the
  // custom domain's certificate and DNS are doing. The custom domain is the
  // product's real address; this is the one that works today.
  "workers_dev": true,
  // The house's pattern: cancoder, stow and dedupe are all
  // `<product>.chesterhillsolutions.ca`. The `civicsignal.ca` domain in the
  // original config is not a zone in this account, so it cannot be routed to
  // anything; registering it is the owner's decision and a subdomain works
  // today.
  "routes": [{ "pattern": "api.civicsignal.chesterhillsolutions.ca", "custom_domain": true }]
}
