{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "civicsignal-stage-daily",
  "account_id": "ad5ec479b9a421faa2ed06c3d1c2b23a",
  "main": "worker.ts",
  "compatibility_date": "2026-10-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "limits": { "cpu_ms": 300000, "subrequests": 10000 },
  "workflows": [
    { "binding": "DAILY", "name": "civicsignal-stage-daily", "class_name": "DailyRefresh" },
    { "binding": "CONSULTATIONS", "name": "civicsignal-stage-consultations", "class_name": "ConsultationsRefresh", "script_name": "civicsignal-stage-consultations" },
    { "binding": "NSERC", "name": "civicsignal-stage-funding", "class_name": "FundingRefresh", "script_name": "civicsignal-stage-funding" },
    { "binding": "ESDC", "name": "civicsignal-stage-esdc", "class_name": "EsdcRefresh", "script_name": "civicsignal-stage-esdc" },
    { "binding": "HOUSE", "name": "civicsignal-stage-house", "class_name": "HouseRefresh", "script_name": "civicsignal-stage-house" }
  ],
  "services": [{ "binding": "VERIFY", "service": "civicsignal-stage-daily-checks", "entrypoint": "CombinedServingCheck" }],
  "r2_buckets": [
    { "binding": "ARCHIVE", "bucket_name": "civicsignal-stage-funding" },
    { "binding": "CONSULTATION_ARCHIVE", "bucket_name": "civicsignal-stage-consultations" }
  ],
  "d1_databases": [{
    "binding": "COMMITTEE_DB",
    "database_name": "civicsignal-stage-committees-45-1",
    "database_id": "fb9b6314-4b06-4690-a893-7277a8ea00bb"
  }],
  "triggers": { "crons": ["15 15 * * *"] }
}
