{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "civicsignal-encoder",
  "main": "worker.ts",
  "compatibility_date": "2026-10-20",
  "account_id": "ad5ec479b9a421faa2ed06c3d1c2b23a",
  "containers": [
    {
      "name": "ENCODER",
      "image": "./Dockerfile",
      // The repository root, so the same Dockerfile works here and on Railway:
      // it copies `services/encoder/server.py`, which is where the file is.
      "image_build_context": "../..",
      "max_instances": 1,
      // The model is 157 MB and the Python runtime around it needs room, so
      // the smallest instance type is not enough. `standard-1` is the one with
      // the memory to hold the artefact and the CPU to run it.
      "instance_type": "standard-1",
      // There is deliberately no `envVars` here.
      //
      // The config schema has no field for a container's runtime environment,
      // and wrangler says so: "Unexpected fields found in containers field:
      // envVars". A container started from the configuration alone therefore
      // gets no environment at all — no port, and no token — and a container
      // with no token refuses every request, which reads like a wrong password.
      //
      // The environment is set by the Durable Object instead (see
      // `worker.ts`), which is where it belongs: the token is a secret, and a
      // secret in a configuration file is a secret in a repository.
      "image_vars": {
        "MODEL_REPO": "litert-community/embeddinggemma-2-text-270m-litert-lm",
        "MODEL_FILE": "embeddinggemma-2-text-270m.litertlm",
        "MODEL_ID": "embeddinggemma-2-270m",
        "MODEL_REVISION": "9be6e8b90982095dc05c2bd162e4b954ee4dbac7",
        "MODEL_SHA256": "2d079ee2f6f066b1f368e8d7c819f55214eaef1d0513b312321901f30ab286fb"
      }
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "ENCODER_OBJECT", "class_name": "Encoder" }]
  },
  "exports": {
    "Encoder": {
      "type": "durable-object",
      "storage": "sqlite",
      "container": "ENCODER"
    }
  },
  "observability": { "enabled": true }
}
