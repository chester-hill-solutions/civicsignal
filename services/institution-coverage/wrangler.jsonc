{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "civicsignal-stage-institution-coverage",
  "main": "worker.ts",
  "account_id": "ad5ec479b9a421faa2ed06c3d1c2b23a",
  "compatibility_date": "2026-11-26",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "limits": { "cpu_ms": 300000, "subrequests": 10000 },
  "containers": [{ "class_name": "CoverageRuntime", "name": "civicsignal-stage-institution-coverage",
    "image": "./Dockerfile", "image_build_context": "../..", "max_instances": 2, "instance_type": "standard-2",
    "observability": { "enabled": true } }],
  "durable_objects": { "bindings": [{ "name": "RUNTIME", "class_name": "CoverageRuntime" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CoverageRuntime"] }],
  "r2_buckets": [{ "binding": "ARCHIVE", "bucket_name": "civicsignal-stage-weekly" }],
  "d1_databases": [{ "binding": "CONSULTATIONS_DB", "database_name": "civicsignal-stage-consultations",
    "database_id": "ef80296e-8122-43e9-a8bc-c5e60941bd08" }],
  "workflows": [{ "binding": "COVERAGE", "name": "civicsignal-stage-institution-coverage", "class_name": "InstitutionCoverage" }],
  "triggers": { "crons": ["0 16 * * SAT"] }
}
