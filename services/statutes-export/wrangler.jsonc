{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "civicsignal-stage-statutes-export",
  "main": "worker.ts",
  "account_id": "ad5ec479b9a421faa2ed06c3d1c2b23a",
  "compatibility_date": "2026-11-26",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "containers": [{
    "class_name": "StatutesExportRuntime",
    "name": "civicsignal-stage-statutes-export",
    "image": "./Dockerfile",
    "image_build_context": "../..",
    "max_instances": 1,
    "instance_type": "standard-2",
    "observability": { "enabled": true }
  }],
  "durable_objects": { "bindings": [{ "name": "RUNTIME", "class_name": "StatutesExportRuntime" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["StatutesExportRuntime"] }],
  "r2_buckets": [{ "binding": "ARCHIVE", "bucket_name": "civicsignal-stage-weekly" }],
  "workflows": [{ "binding": "EXPORT", "name": "civicsignal-stage-statutes-export", "class_name": "StatutesExportRefresh" }],
  "triggers": { "crons": ["0 12 * * SAT"] }
}
