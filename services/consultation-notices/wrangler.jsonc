{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "civicsignal-stage-consultation-notices",
  "main": "worker.ts",
  "account_id": "ad5ec479b9a421faa2ed06c3d1c2b23a",
  "compatibility_date": "2026-11-26",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "upload_source_maps": true,
  "observability": { "enabled": true },
  "containers": [{
    "class_name": "ConsultationNoticesRuntime",
    "name": "civicsignal-stage-consultation-notices",
    "image": "./Dockerfile",
    "image_build_context": "../..",
    "max_instances": 2,
    "instance_type": "standard-2",
    "observability": { "enabled": true }
  }],
  "durable_objects": { "bindings": [{ "name": "RUNTIME", "class_name": "ConsultationNoticesRuntime" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ConsultationNoticesRuntime"] }],
  "d1_databases": [{ "binding": "CONSULTATIONS_DB", "database_name": "civicsignal-stage-consultations", "database_id": "ef80296e-8122-43e9-a8bc-c5e60941bd08" }],
  "r2_buckets": [
    { "binding": "ARCHIVE", "bucket_name": "civicsignal-stage-weekly" },
    { "binding": "CONSULTATIONS_ARCHIVE", "bucket_name": "civicsignal-stage-consultations" }
  ],
  "workflows": [{ "binding": "NOTICES", "name": "civicsignal-stage-consultation-notices", "class_name": "ConsultationNoticesRefresh" }],
  "triggers": { "crons": ["0 17 * * SAT"] }
}
