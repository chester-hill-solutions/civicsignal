@@ -0,0 +1,240 @@
+import { afterEach, describe, expect, test } from 'bun:test';
+import type { DurableObjectState } from '@cloudflare/workers-types';
+import { ApiKeyUsageDO, DurableObjectUsageLedger, type DurableObjectNamespaceLike } from './durable-object.js';
+import { recordSuccessfulBillable, reportStripeMeter } from './meter.js';
+import { InMemoryUsageLedger } from './usage-ledger.js';
+import type { MeteredCustomer, UsageLedgerResult } from './types.js';
+
+const NOW = Date.UTC(2026, 9, 22);
+const MONTH_KEY = 'month:2026-10';
+const CONFIG = { freeFuseLimit: 5, meterEventName: 'test-retrieval' };
+const customer = (overrides: Partial<MeteredCustomer> = {}): MeteredCustomer => ({
+  id: 'existing-customer', plan: 'free', fuseLimit: 5, fuseSoftWarn: false, ...overrides,
+});
+
+/** Persistent transactional storage adapter; serializes commits and rolls back failures. */
+function objectFixture(seed = 0) {
+  let data = new Map<string, unknown>([[MONTH_KEY, seed]]);
+  let tail = Promise.resolve();
+  let failCommit = false;
+  const storage = {
+    async get<T>(key: string): Promise<T | undefined> { return data.get(key) as T | undefined; },
+    async put(key: string, value: unknown) { data.set(key, value); },
+    async transaction<T>(work: (transaction: {
+      get<U>(key: string): Promise<U | undefined>;
+      put(entries: Record<string, unknown>): Promise<void>;
+    }) => Promise<T>): Promise<T> {
+      const result = tail.then(async () => {
+        const pending = new Map(data);
+        const result = await work({
+          async get<U>(key: string) { return pending.get(key) as U | undefined; },
+          async put(entries) { for (const [key, value] of Object.entries(entries)) pending.set(key, value); },
+        });
+        if (failCommit) { failCommit = false; throw new Error('Synthetic transaction rollback'); }
+        data = pending;
+        return result;
+      });
+      tail = result.then(() => {}, () => {});
+      return result;
+    },
+  };
+  // The class needs only this storage subset. Cloudflare provides the runtime's
+  // transaction implementation; this fixture tests the actual DO protocol/code.
+  const state = { storage } as unknown as DurableObjectState;
+  const object = new ApiKeyUsageDO(state);
+  const names: string[] = [];
+  let requests = 0;
+  let posts = 0;
+  let failBeforePost = 0;
+  let losePostResponse = 0;
+  let partitionAfterPost = false;
+  let partitioned = false;
+  const namespace: DurableObjectNamespaceLike = {
+    idFromName(name) { names.push(name); return name; },
+    get() { return { async fetch(input, init) {
+      requests++;
+      if (partitioned) throw new Error('Synthetic permanent partition');
+      const request = new Request(input, init);
+      if (request.method === 'POST') {
+        posts++;
+        if (failBeforePost-- > 0) throw new Error('Synthetic transport failure before delivery');
+      }
+      const response = await object.fetch(request);
+      if (request.method === 'POST' && partitionAfterPost) { partitioned = true; throw new Error('Synthetic lost acknowledgement'); }
+      if (request.method === 'POST' && losePostResponse-- > 0) throw new Error('Synthetic lost acknowledgement');
+      return response;
+    } }; },
+  };
+  return {
+    namespace, object, names,
+    count: () => data.get(MONTH_KEY),
+    stats: () => ({ requests, posts }),
+    receiptCount: () => [...data.keys()].filter((key) => key.startsWith('operation:')).length,
+    loseResponse: () => { losePostResponse = 1; },
+    failBeforeDelivery: () => { failBeforePost = 1; },
+    failNextCommit: () => { failCommit = true; },
+    partitionAfterCommit: () => { partitionAfterPost = true; },
+    restore: () => { partitioned = false; partitionAfterPost = false; },
+  };
+}
+
+function ledger(fixture: ReturnType<typeof objectFixture>) {
+  return new DurableObjectUsageLedger(fixture.namespace, { failureMode: 'closed', acknowledgementRetries: 2 });
+}
+
+describe('idempotent Durable Object consumption', () => {
+  test('retains existing namespace/month count and acknowledges a receipt across clients', async () => {
+    const fixture = objectFixture(7);
+    const first = await ledger(fixture).consumeMonthly(customer().id, 10, NOW, { operationId: 'operation-one' });
+    const duplicate = await ledger(fixture).consumeMonthly(customer().id, 10, NOW, { operationId: 'operation-one' });
+    expect(first.allowed).toBe(true);
+    expect(first.count).toBe(8);
+    expect(duplicate).toEqual(first);
+    expect(fixture.count()).toBe(8);
+    expect(fixture.receiptCount()).toBe(1);
+    expect(new Set(fixture.names)).toEqual(new Set(['customer:existing-customer']));
+    // A subsequent policy change must not make an acknowledged operation charge again.
+    expect((await ledger(fixture).consumeMonthly(customer().id, 1, NOW, { operationId: 'operation-one' })).count).toBe(8);
+  });
+
+  test('recovers a committed POST whose response was lost with one increment', async () => {
+    const fixture = objectFixture();
+    fixture.loseResponse();
+    const result = await recordSuccessfulBillable(customer(), CONFIG, {
+      ledger: ledger(fixture), nowMs: NOW, operationId: 'lost-ack', usageFailureMode: 'closed',
+    });
+    expect(result).toEqual({ allowed: true, status: 200 });
+    expect(fixture.count()).toBe(1);
+    expect(fixture.stats()).toEqual({ requests: 3, posts: 1 });
+  });
+
+  test('retries a POST that never arrived using the same identity', async () => {
+    const fixture = objectFixture();
+    fixture.failBeforeDelivery();
+    expect((await ledger(fixture).consumeMonthly('c', 5, NOW, { operationId: 'not-delivered' })).allowed).toBe(true);
+    expect(fixture.count()).toBe(1);
+    expect(fixture.stats()).toEqual({ requests: 4, posts: 2 });
+  });
+
+  test('rolls back counter and receipt together before retrying', async () => {
+    const fixture = objectFixture(2);
+    fixture.failNextCommit();
+    expect((await ledger(fixture).consumeMonthly('c', 5, NOW, { operationId: 'rollback' })).count).toBe(3);
+    expect(fixture.count()).toBe(3);
+    expect(fixture.receiptCount()).toBe(1);
+  });
+
+  test('returns truthful uncertain 503 during a permanent post-commit partition, then reconciles', async () => {
+    const fixture = objectFixture();
+    fixture.partitionAfterCommit();
+    const result = await recordSuccessfulBillable(customer(), CONFIG, {
+      ledger: ledger(fixture), nowMs: NOW, operationId: 'partitioned', usageFailureMode: 'closed',
+    });
+    expect(result.status).toBe(503);
+    expect(result.body).toMatchObject({ code: 'USAGE_UNAVAILABLE', operationId: 'partitioned', uncertain: true, month: '2026-10' });
+    expect(fixture.count()).toBe(1);
+    expect(fixture.stats().requests).toBe(4);
+    fixture.restore();
+    const recovered = await ledger(fixture).consumeMonthly(customer().id, 5, NOW, { operationId: 'partitioned' });
+    expect(recovered.allowed).toBe(true);
+    expect(fixture.count()).toBe(1);
+  });
+
+  test('refuses an old protocol before POST instead of silently counting each retry', async () => {
+    let posts = 0;
+    const client = new DurableObjectUsageLedger({ idFromName: (name) => name, get: () => ({
+      async fetch(_url, init) {
+        if (init?.method === 'POST') posts++;
+        return Response.json({ allowed: true, count: posts, limit: 5, month: '2026-10' });
+      },
+    }) }, { failureMode: 'closed' });
+    const result = await client.consumeMonthly('c', 5, NOW, { operationId: 'requires-v2' });
+    expect(result).toMatchObject({ allowed: false, unavailable: true });
+    expect(posts).toBe(0);
+  });
+
+  test('exhausted quota remains 429 and refusals never increment', async () => {
+    const fixture = objectFixture(4);
+    const client = ledger(fixture);
+    expect((await recordSuccessfulBillable(customer(), CONFIG, { ledger: client, nowMs: NOW, operationId: 'last' })).allowed).toBe(true);
+    const refused = await recordSuccessfulBillable(customer(), CONFIG, { ledger: client, nowMs: NOW, operationId: 'refused' });
+    expect(refused).toMatchObject({ allowed: false, status: 429, body: { code: 'FUSE_EXCEEDED', count: 5 } });
+    expect((await client.consumeMonthly('existing-customer', 5, NOW, { operationId: 'refused' })).allowed).toBe(false);
+    expect(fixture.count()).toBe(5);
+  });
+
+  test('concurrent duplicate operations count once, while distinct operations respect the last unit', async () => {
+    const fixture = objectFixture();
+    const client = ledger(fixture);
+    const same = await Promise.all(Array.from({ length: 8 }, () => client.consumeMonthly('c', 3, NOW, { operationId: 'same' })));
+    expect(same.every((result) => result.allowed && result.count === 1)).toBe(true);
+    const distinct = await Promise.all(Array.from({ length: 8 }, (_, index) => client.consumeMonthly('c', 3, NOW, { operationId: `distinct-${index}` })));
+    expect(distinct.filter((result) => result.allowed)).toHaveLength(2);
+    expect(fixture.count()).toBe(3);
+  });
+
+  test('an unlabelled legacy POST is never retried after a lost response', async () => {
+    const fixture = objectFixture();
+    fixture.loseResponse();
+    const result = await ledger(fixture).consumeMonthly('c', 5, NOW);
+    expect(result).toMatchObject({ allowed: false, unavailable: true, uncertain: true });
+    expect(fixture.count()).toBe(1);
+    expect(fixture.stats()).toEqual({ requests: 1, posts: 1 });
+  });
+});
+
+describe('closed usage policy', () => {
+  const offline: DurableObjectNamespaceLike = { idFromName: (name) => name, get: () => ({ async fetch() { throw new Error('Offline'); } }) };
+  for (const overrides of [{ plan: 'metered' as const, fuseLimit: 0 }, { plan: 'enterprise' as const, fuseLimit: 0 }, { fuseSoftWarn: true }]) {
+    test(`fails closed for ${JSON.stringify(overrides)} without pretending quota is exhausted`, async () => {
+      const client = new DurableObjectUsageLedger(offline, { failureMode: 'closed' });
+      expect(await client.peekMonthly('c', 0, NOW)).toMatchObject({ allowed: false, unavailable: true });
+      const result = await recordSuccessfulBillable(customer(overrides), CONFIG, {
+        ledger: client, nowMs: NOW, operationId: 'offline', usageFailureMode: 'closed',
+      });
+      expect(result).toMatchObject({ allowed: false, status: 503, body: { code: 'USAGE_UNAVAILABLE', uncertain: false } });
+    });
+  }
+
+  test('product closed policy also rejects an explicitly unavailable fail-open ledger result', async () => {
+    const client = new DurableObjectUsageLedger(offline);
+    expect((await client.peekMonthly('c', 0, NOW)).allowed).toBe(true); // Compatibility default.
+    const result = await recordSuccessfulBillable(customer({ plan: 'enterprise', fuseLimit: 0 }), CONFIG, {
+      ledger: client, nowMs: NOW, usageFailureMode: 'closed',
+    });
+    expect(result.status).toBe(503);
+  });
+
+  test('does not claim operation support for an arbitrary legacy ledger', async () => {
+    let calls = 0;
+    const legacy = { async consumeMonthly(): Promise<UsageLedgerResult> { calls++; return { allowed: true, count: 1, limit: 0, month: '2026-10' }; },
+      async peekMonthly(): Promise<UsageLedgerResult> { throw new Error('Unused'); } };
+    expect((await recordSuccessfulBillable(customer(), CONFIG, { ledger: legacy, nowMs: NOW, operationId: 'unsupported' })).status).toBe(503);
+    expect(calls).toBe(0);
+  });
+
+  test('the in-memory adapter uses the same operation semantics', async () => {
+    const client = new InMemoryUsageLedger();
+    await client.consumeMonthly('c', 5, NOW, { operationId: 'one' });
+    await client.consumeMonthly('c', 5, NOW, { operationId: 'one' });
+    expect((await client.peekMonthly('c', 5, NOW)).count).toBe(1);
+  });
+});
+
+const realFetch = globalThis.fetch;
+afterEach(() => { globalThis.fetch = realFetch; });
+test('Stripe event identifier is stable for the same customer, month and operation', async () => {
+  const identifiers: string[] = [];
+  globalThis.fetch = (async (_input, init) => {
+    identifiers.push(new URLSearchParams(String(init?.body)).get('identifier')!);
+    return Response.json({});
+  }) as typeof fetch;
+  const config = { ...CONFIG, stripeSecretKey: 'synthetic-test-secret' };
+  const billed = customer({ plan: 'metered', stripeCustomerId: 'stripe-test-customer' });
+  await reportStripeMeter(billed, config, 1, NOW, 'same-operation');
+  await reportStripeMeter(billed, config, 1, NOW, 'same-operation');
+  await reportStripeMeter(billed, config, 1, NOW, 'other-operation');
+  expect(identifiers[0]).toBe(identifiers[1]);
+  expect(identifiers[0]).not.toBe(identifiers[2]);
+  expect(identifiers[0]).not.toContain(billed.id);
+});
