{
  "name": "civicsignal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Situational awareness for Canada \u2014 legislation, news, sentiment and geography for any topic.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate": "bun run typecheck && bun run test",
    "check:billing-invariants": "node scripts/check-billing-invariants.mjs",
    "ingest:statutes": "bun scripts/ingest-statutes.ts",
    "embed:statutes": "bun scripts/embed-corpus.ts",
    "eval:retrieval": "bun scripts/eval-retrieval.ts",
    "seed:act-titles": "bun scripts/seed-act-titles.ts"
  },
  "dependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "@modelcontextprotocol/server": "2.3.1",
    "zod": "^4.6.5",
    "fast-xml-parser": "^4.5.0",
    "@chester-hill-solutions/corpus": "file:./vendor/@chester-hill-solutions/corpus"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@electric-sql/pglite-pgvector": "0.0.11",
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8",
    "wrangler": "4.151.3"
  }
}
