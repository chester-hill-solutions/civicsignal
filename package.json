{
  "name": "civicsignal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cited Canadian federal statute and regulation retrieval in English and French.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "bun run typecheck:worker && bun run typecheck:bun && bun run typecheck:tooling && bun run typecheck:snapshot",
    "test": "vitest run",
    "validate": "bun run check:vendor && bun run check:lint-ratchet && bun run typecheck && CIVICSIGNAL_WORKERD_TESTS=1 bun run test && bun run check:runtime && bun run check:billing-invariants && bun run check:corpus-invariants",
    "lint": "eslint .",
    "check:lint-ratchet": "node scripts/check-lint-ratchet.mjs",
    "tools:lint-ratchet:tighten": "ratchet-strap tighten --exec-eslint --write",
    "check:billing-invariants": "node scripts/check-billing-invariants.mjs",
    "check:corpus-invariants": "node scripts/check-corpus-invariants.mjs",
    "refresh:committee-calls": "python3 -B scripts/committee-calls.py",
    "refresh:daily": "bun scripts/refresh-daily.ts",
    "check:railway-iac": "bun scripts/check-railway-iac.ts",
    "ingest:statutes": "bun scripts/ingest-statutes.ts",
    "embed:statutes": "bun scripts/embed-corpus.ts",
    "eval:retrieval": "bun scripts/eval-retrieval.ts",
    "seed:act-titles": "bun scripts/seed-act-titles.ts",
    "materialize:consultations": "bun scripts/materialize-consultations.ts",
    "refresh:consultations": "bun scripts/materialize-consultations.ts --csv https://open.canada.ca/static/consultations_open.csv --schema https://open.canada.ca/data/recombinant-published-schema/consultations.json",
    "typecheck:worker": "tsc -p tsconfig.worker.json",
    "typecheck:bun": "tsc -p tsconfig.bun.json",
    "typecheck:tooling": "tsc -p tsconfig.tooling.json",
    "build": "bun run build:api && bun run build:api-guides && bun run build:pipeline && bun run build:encoder && bun run build:snapshot && bun run build:restore && bun run build:home && bun run build:consultations && bun run build:funding && bun run build:esdc && bun run build:daily-checks && bun run build:house && bun run build:daily && bun run build:federal-register && bun run build:institution-coverage",
    "build:api-guides": "wrangler deploy --config services/api-guides/wrangler.jsonc --dry-run --outdir dist/build/api-guides",
    "build:institution-coverage": "wrangler deploy --config services/institution-coverage/wrangler.jsonc --dry-run --containers-rollout=none --outdir dist/build/institution-coverage",
    "build:federal-register": "wrangler deploy --config services/federal-register/wrangler.jsonc --dry-run --outdir dist/build/federal-register && wrangler deploy --config services/federal-register/collector/wrangler.jsonc --dry-run --outdir dist/build/federal-register-collector",
    "build:daily": "wrangler deploy --config services/daily/wrangler.jsonc --dry-run --outdir dist/build/daily",
    "build:house": "wrangler deploy --config services/house/wrangler.jsonc --dry-run --outdir dist/build/house && wrangler deploy --config services/house-collector/wrangler.jsonc --dry-run --outdir dist/build/house-collector",
    "build:daily-checks": "wrangler deploy --config services/daily-checks/wrangler.jsonc --dry-run --outdir dist/build/daily-checks",
    "build:esdc": "wrangler deploy --config services/funding/esdc/wrangler.jsonc --dry-run --outdir dist/build/esdc && wrangler deploy --config services/funding/esdc-collector/wrangler.jsonc --dry-run --outdir dist/build/esdc-collector",
    "build:funding": "wrangler deploy --config services/funding/wrangler.jsonc --dry-run --outdir dist/build/funding && wrangler deploy --config services/funding/collector/wrangler.jsonc --dry-run --outdir dist/build/collector",
    "build:consultations": "wrangler deploy --config services/consultations/wrangler.jsonc --dry-run --outdir dist/build/consultations",
    "build:api": "wrangler deploy --dry-run --outdir dist/build/api",
    "build:pipeline": "wrangler deploy --config services/pipeline/wrangler.jsonc --dry-run --outdir dist/build/pipeline",
    "build:encoder": "wrangler deploy --config services/encoder/wrangler.jsonc --dry-run --containers-rollout=none --outdir dist/build/encoder",
    "check:vendor": "bun scripts/check-vendor.ts",
    "typecheck:snapshot": "tsc -p services/snapshot/tsconfig.json",
    "build:snapshot": "wrangler deploy --config services/snapshot/wrangler.jsonc --dry-run --outdir dist/build/snapshot",
    "build:home": "wrangler deploy --config services/home/wrangler.jsonc --dry-run --outdir dist/build/home",
    "eval:v1": "bun scripts/eval-v1.ts",
    "bench:v1": "bun scripts/bench-v1.ts",
    "check:runtime": "node scripts/check-usage-ledger-runtime.ts && node scripts/check-r2-immutability.ts",
    "build:restore": "wrangler deploy --config services/restore/wrangler.jsonc --dry-run --outdir dist/build/restore"
  },
  "dependencies": {
    "@chester-hill-solutions/api-billing": "workspace:*",
    "@chester-hill-solutions/corpus": "workspace:*",
    "@cloudflare/containers": "^0.3.7",
    "@cloudflare/workers-types": "^4.20250109.0",
    "@modelcontextprotocol/server": "2.3.1",
    "fast-xml-parser": "^4.5.0",
    "postgres": "^3.4.5",
    "zod": "^4.6.5",
    "@chester-hill-solutions/app-origin": "workspace:*",
    "@chester-hill-solutions/auth": "workspace:*",
    "@chester-hill-solutions/auth-d1": "workspace:*",
    "better-auth": "1.7.10",
    "@better-auth/drizzle-adapter": "1.7.10",
    "drizzle-orm": "0.45.2",
    "cookie": "1.1.1"
  },
  "devDependencies": {
    "@chester-hill-solutions/ratchet-strap": "0.7.2",
    "@electric-sql/pglite": "0.5.10",
    "@electric-sql/pglite-pgvector": "0.0.11",
    "@opencode/plugin": "^2.1.1",
    "@shadcn/lint": "0.1.1",
    "@types/node": "^22.10.5",
    "@typescript-eslint/eslint-plugin": "8.63.0",
    "@typescript-eslint/parser": "8.63.0",
    "bun-types": "^1.3.5",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "miniflare": "5.20261019.1-beta",
    "railway": "^3.16.0",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8",
    "wrangler": "4.151.3"
  },
  "workspaces": [
    "vendor/@chester-hill-solutions/*"
  ]
}
